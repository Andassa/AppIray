# Application
APP_NAME=AppIray
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# Database
DATABASE_URL=postgresql+asyncpg://appiray:appiray@postgres:5432/appiray

# Redis
REDIS_URL=redis://redis:6379/0

# Storage (local | s3)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
# S3 / Cloudflare R2 (used when STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=appiray
S3_REGION=auto
PUBLIC_ASSET_BASE_URL=http://localhost:8000/static

# Gamification defaults
MAX_HEARTS=5
XP_PER_CORRECT_ANSWER=10
STREAK_GRACE_HOURS=36

# Hearts regeneration & economy (all tunable)
HEART_REFILL_MINUTES=240
GEM_COST_HEART_REFILL=350
GEM_COST_STREAK_FREEZE=200
STREAK_FREEZE_DAYS=1
DEFAULT_DAILY_XP_GOAL=20
GEMS_PER_LESSON=5
GEMS_PER_DAILY_GOAL=20
PRACTICE_XP_REWARD=5
PRACTICE_GEMS_REWARD=1

# Auth token lifetimes (password reset / email verification)
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440
PUBLIC_APP_URL=http://localhost:8000

# Side-effect backends: "log" (default) until a real provider is wired in
EMAIL_SENDER_BACKEND=log
PUSH_SENDER_BACKEND=log

# Rate limiting
RATE_LIMIT_AUTH_PER_MINUTE=10

# Admin bootstrap (optional — created on startup if set)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_USERNAME=admin
