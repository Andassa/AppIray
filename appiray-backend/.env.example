# Application
APP_NAME=AppIray
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# Database
DATABASE_URL=postgresql+asyncpg://appiray:appiray@postgres:5432/appiray

# Redis
REDIS_URL=redis://redis:6379/0

# Storage (local | s3)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
# S3 / Cloudflare R2 (used when STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=appiray
S3_REGION=auto
PUBLIC_ASSET_BASE_URL=http://localhost:8000/static

# Gamification defaults
MAX_HEARTS=5
XP_PER_CORRECT_ANSWER=10
STREAK_GRACE_HOURS=36

# Rate limiting
RATE_LIMIT_AUTH_PER_MINUTE=10

# Admin bootstrap (optional — created on startup if set)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_USERNAME=admin
