# --- Génération audio ---
# Nom du checkpoint Hugging Face à utiliser (base Meta, ou ton futur checkpoint fine-tuné)
TTS_MODEL_NAME=facebook/mms-tts-mlg

# Identifiant de version de la voix, stocké avec chaque audio_asset côté backend
# Utile pour savoir plus tard quels fichiers regénérer si tu changes de modèle
VOICE_MODEL_VERSION=mms-base-v1

# --- Upload vers AppIray ---
APPIRAY_API_BASE=http://localhost:8000/api/v1

# Un compte admin AppIray existant (créé via BOOTSTRAP_ADMIN_* du backend)
APPIRAY_ADMIN_EMAIL=admin@appiray.local
APPIRAY_ADMIN_PASSWORD=change-me
